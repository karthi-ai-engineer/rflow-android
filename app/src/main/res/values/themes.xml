<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: Obsidian Signal's base, so opening never flashes white. -->
    <style name="Theme.Rflow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="base">#191C22</color>
</resources>
